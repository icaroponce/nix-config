cabal-version:   3.0
name:            project
version:         0.1.0.0
build-type:      Simple

common shared
  default-language: GHC2021
  ghc-options:      -Wall
  build-depends:    base >=4.14 && <5

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules: Lib

executable project
  import:         shared
  hs-source-dirs: app
  main-is:        Main.hs
  build-depends:  project
  ghc-options:    -threaded -rtsopts

test-suite project-test
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  build-depends:  project
